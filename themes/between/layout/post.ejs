<article class="article-shell">
  <aside class="article-toc" aria-label="Table of contents">
    <div class="article-toc-sticky">
      <%- toc(page.content, { list_number: false, max_depth: 3 }) %>
    </div>
  </aside>
  <div class="article-main">
    <header class="article-header">
      <div class="article-header-topline">
        <span>Archive <%= String(page.slug).padStart(2, '0') %></span>
        <button class="article-share" type="button" data-share aria-label="Share article" title="Share article">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
        </button>
      </div>
      <h1><%= page.title %></h1>
      <div class="article-meta">
        <time datetime="<%= page.date.toISOString() %>"><%= page.date.format('MMM DD, YYYY HH:mm') %></time>
        <% if (page.tags && page.tags.length) { %>
          <span aria-hidden="true"> | </span>
          <% page.tags.each(function (tag, index) { %><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a><%= index < page.tags.length - 1 ? ' ' : '' %><% }); %>
        <% } %>
      </div>
      <%- partial('_partial/article-onchain', { articleChain: article_onchain_meta(page.slug) }) %>
    </header>
    <% if (page.original_url) { %>
      <p class="article-origin">本文同步自原博客 <span aria-hidden="true">·</span> <a href="<%= page.original_url %>" target="_blank" rel="noopener noreferrer">阅读原文&nbsp;↗</a></p>
    <% } %>
    <div class="article-content"><%- page.content %></div>
    <footer class="article-footer">
      <span>Last updated <%= page.updated.format('MMM DD, YYYY') %></span>
      <a href="<%- url_for('/blog/') %>">Back to Blogs</a>
    </footer>
  </div>
  <div class="article-balance" aria-hidden="true"></div>
</article>
