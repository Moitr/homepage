<!doctype html>
<html lang="<%= config.language || 'en' %>">
  <% const assetVersion = build_meta().hash; %>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="<%= page.description || page.excerpt || config.description %>">
    <link rel="canonical" href="<%= page.original_url || full_url_for(page.path) %>">
    <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
    <script>
      (function () {
        var saved = localStorage.getItem('color-theme');
        var dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var navigationEntry = window.performance && window.performance.getEntriesByType
          ? window.performance.getEntriesByType('navigation')[0]
          : null;
        document.documentElement.classList.toggle('dark', dark);
        if (navigationEntry && navigationEntry.type === 'back_forward') {
          document.documentElement.classList.add('is-history-return');
        }
      }());
    </script>
    <link rel="stylesheet" href="<%- url_for('/css/style.css') %>?v=<%= assetVersion %>">
  </head>
  <body class="<%= page.layout ? 'page-' + page.layout : '' %>">
    <%- partial('_partial/nav') %>
    <main id="main-content">
      <%- body %>
      <% if (page.layout === 'index' || page.layout === 'about' || page.path === 'index.html' || page.path === 'about/index.html') { %><%- partial('_partial/scroll-blur') %><% } %>
    </main>
    <%- partial('_partial/footer') %>
    <script src="<%- url_for('/js/app.js') %>?v=<%= assetVersion %>" defer></script>
  </body>
</html>
