<!doctype html>
<html lang="<%= config.language || 'en' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <meta name="description" content="<%= page.description || page.excerpt || config.description %>">
    <link rel="canonical" href="<%= page.original_url || full_url_for(page.path) %>">
    <title><%= page.title ? page.title + ' | ' : '' %><%= config.title %></title>
    <script>
      (function () {
        var saved = localStorage.getItem('color-theme');
        var dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      }());
    </script>
    <link rel="preload" href="<%- url_for('/fonts/files/inter-latin-standard-normal.woff2') %>" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="<%- url_for('/fonts/fonts.css') %>">
    <% const hasCode = page.layout === 'post' && /<(pre|figure class="highlight")\b/.test(page.content || ''); %>
    <% const hasMermaid = page.layout === 'post' && /<code class="[^"]*\bmermaid\b/.test(page.content || ''); %>
    <% if (hasCode) { %>
      <link id="highlight-light-theme" rel="stylesheet" href="<%- url_for('/css/vendor/highlight-catppuccin-latte.css') %>">
      <link id="highlight-dark-theme" rel="stylesheet" href="<%- url_for('/css/vendor/highlight-catppuccin-macchiato.css') %>" media="not all">
      <script>
        (function () {
          var dark = document.documentElement.classList.contains('dark');
          document.getElementById('highlight-light-theme').media = dark ? 'not all' : 'all';
          document.getElementById('highlight-dark-theme').media = dark ? 'all' : 'not all';
        }());
      </script>
    <% } %>
    <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  </head>
  <body class="<%= page.layout ? 'page-' + page.layout : '' %>">
    <%- partial('_partial/nav') %>
    <main id="main-content"><%- body %></main>
    <% if (page.layout === 'index' || page.layout === 'about' || page.path === 'index.html' || page.path === 'about/index.html') { %><%- partial('_partial/scroll-blur') %><% } %>
    <%- partial('_partial/footer') %>
    <script src="<%- url_for('/js/main.js') %>" defer></script>
    <% if (hasMermaid) { %><script type="module" src="<%- url_for('/js/mermaid-init.js') %>"></script><% } %>
  </body>
</html>
