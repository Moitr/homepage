<%
const links = friend_links_randomized();
const chain = friend_links_onchain_meta();
const verifyUrl = chain.transaction_hash ? 'https://polygonscan.com/tx/' + chain.transaction_hash : (chain.contract_address ? 'https://polygonscan.com/address/' + chain.contract_address : '');
%>
<section class="friends-shell">
  <header class="friends-header">
    <h1>友谊地久天长。</h1>
    <p class="friends-proof">
      友链数据已存证于 Polygon。
      <% if (verifyUrl) { %><a href="<%= verifyUrl %>" target="_blank" rel="noopener noreferrer">验证记录 <span aria-hidden="true">↗</span></a><% } %>
      <span class="friends-proof-separator" aria-hidden="true">·</span>
      <a href="https://moitr.ren/friends" target="_blank" rel="noopener noreferrer">友链申请或查看原页面 <span aria-hidden="true">↗</span></a>
    </p>
  </header>

  <% if (links.length) { %>
    <div class="friends-grid">
      <% links.forEach(function (link) { const initial = Array.from(String(link.name || '?').trim()).slice(0, 2).join('') || '?'; %>
        <a class="friend-card" href="<%= link.url %>" target="_blank" rel="noopener noreferrer" aria-label="访问 <%= link.name %>">
          <span class="friend-avatar" aria-hidden="true">
            <span><%= initial %></span>
            <% if (link.avatar) { %><img src="<%= link.avatar %>" alt="" width="52" height="52" loading="lazy" decoding="async" data-friend-avatar><% } %>
          </span>
          <span class="friend-copy">
            <strong><%= link.name %></strong>
            <% if (link.description) { %><span><%= link.description %></span><% } %>
          </span>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <p class="friends-empty">暂无公开友链。</p>
  <% } %>
</section>
