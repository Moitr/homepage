<% const currentPath = page.path || ''; %>
<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <button class="icon-button mobile-menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="Open navigation">
      <svg class="icon icon-menu" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
      <svg class="icon icon-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <div class="desktop-nav">
      <div class="nav-links">
        <% Object.entries(theme.menu || {}).forEach(function ([label, path]) { const active = path === '/' ? (currentPath === 'index.html' || currentPath === 'about/index.html') : currentPath.indexOf(path.replace(/^\//, '')) === 0; %>
          <a class="nav-link <%= active ? 'is-active' : '' %>" href="<%- url_for(path) %>"><%= label %></a>
        <% }); %>
      </div>
      <span class="nav-divider" aria-hidden="true"></span>
      <div class="nav-actions">
        <a class="icon-button" href="<%= theme.github_url %>" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5a15.4 15.4 0 0 0-8 0C6 2 5 2 5 2a8.8 8.8 0 0 0 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5A4 4 0 0 0 9 18v4M9 18c-4.5 2-5-2-7-2"/></svg>
        </a>
        <button class="icon-button" type="button" data-theme-toggle aria-label="Switch color theme" title="Theme">
          <svg class="icon theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
          <svg class="icon theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
        </button>
      </div>
    </div>
  </nav>

</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" hidden>
  <div class="mobile-nav-links">
    <% Object.entries(theme.menu || {}).forEach(function ([label, path]) { const active = path === '/' ? (currentPath === 'index.html' || currentPath === 'about/index.html') : currentPath.indexOf(path.replace(/^\//, '')) === 0; %>
      <a class="<%= active ? 'is-active' : '' %>" href="<%- url_for(path) %>"><%= label %></a>
    <% }); %>
  </div>
  <div class="mobile-nav-actions">
    <a class="icon-button" href="<%= theme.github_url %>" target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5a15.4 15.4 0 0 0-8 0C6 2 5 2 5 2a8.8 8.8 0 0 0 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5A4 4 0 0 0 9 18v4M9 18c-4.5 2-5-2-7-2"/></svg>
    </a>
    <button class="icon-button" type="button" data-theme-toggle aria-label="Switch color theme" title="Theme">
      <svg class="icon theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/></svg>
      <svg class="icon theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
    </button>
  </div>
</div>
