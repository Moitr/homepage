{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "test": "node --test test/*.test.js",
    "content:sync": "node tools/sync-content.js",
    "readme:update": "node tools/update-readme-articles.js",
    "readme:check": "node tools/update-readme-articles.js --check",
    "links:sync": "node tools/sync-friend-links.js",
    "onchain:check": "node tools/publish-homepage-polygon.js --check",
    "onchain:publish": "node tools/publish-homepage-polygon.js",
    "onchain:check:articles": "node tools/publish-articles-polygon.js --check",
    "onchain:publish:articles": "node tools/publish-articles-polygon.js",
    "onchain:check:links": "node tools/publish-friend-links-polygon.js --check",
    "onchain:publish:links": "node tools/publish-friend-links-polygon.js"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "hexo": "^8.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "mermaid": "11.12.3"
  },
  "devDependencies": {
    "ethers": "6.17.0",
    "hexo-cli": "^4.3.2",
    "hexo-front-matter": "4.2.1",
    "js-yaml": "4.1.0",
    "marked": "15.0.12",
    "solc": "0.8.36"
  }
}
